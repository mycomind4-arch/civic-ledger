{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.humboldt-digital-commons.invalid/parcel-reference.schema.json",
  "title": "Parcel Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jurisdiction",
    "apn",
    "canonicalId",
    "sourceSystem",
    "observedAt"
  ],
  "properties": {
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "apn": {
      "type": "string",
      "minLength": 1
    },
    "canonicalId": {
      "type": "string",
      "minLength": 1
    },
    "sourceSystem": {
      "type": "string",
      "minLength": 1
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "geometryUrl": {
      "type": "string",
      "format": "uri"
    },
    "centroid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ],
          "items": false
        }
      }
    },
    "sourceMetadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
